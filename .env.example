# Copy to .env and restart the server after editing. Everything here is optional:
# without these values the app runs with no login (anyone on the computer can open the Parents tab).

# --- Auth0 login for the Parents area (optional) ---
# 1. auth0.com > Applications > Create Application > "Regular Web Application".
# 2. In its Settings, paste the three values below.
# 3. Still in Settings, set (use the same port you run the server on, 8765 by default):
#      Allowed Callback URLs: http://localhost:8765/auth/callback, http://127.0.0.1:8765/auth/callback
#      Allowed Logout URLs:   http://localhost:8765/, http://127.0.0.1:8765/
#    The server prints the exact URLs on startup. "Callback URL mismatch" means one of them is missing.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Any long random text, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Verified e-mails allowed in the Parents area, comma-separated.
PARENT_EMAILS=
# Optional: pin the address so login always uses one URL (then register only this one in Auth0).
# APP_BASE_URL=http://localhost:8765

# --- Local model (Ollama) ---
# OLLAMA_URL=http://localhost:11434
# NG_MODEL=gemma4:e4b
